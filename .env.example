# Copy to .env for local development (never commit .env)
TAVERN_LISTEN=0.0.0.0:8084
TAVERN_DATA_DIR=./data
TAVERN_ADMIN_USER=tavern_admin
TAVERN_ADMIN_PASS=change-me-to-a-strong-password
