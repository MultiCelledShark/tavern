# Copy to .env for local development (never commit .env)
#
# Internet / production: keep listen on loopback behind nginx/Caddy, set
# COOKIE_SECURE + TRUST_PROXY only when TLS terminates at that proxy, configure
# SMTP + PUBLIC_URL, and set SIGNUP=0 until mail delivery is proven.
TAVERN_LISTEN=127.0.0.1:8084
# For LAN-only testing without a proxy you may use 0.0.0.0:8084 instead.
TAVERN_DATA_DIR=./data
TAVERN_DATABASE_URL=postgres://tavern:tavern@127.0.0.1:5432/tavern
TAVERN_ADMIN_USER=tavern_admin
# Required: ≥12 chars; "admin" and "change-me-to-a-strong-password" are refused.
TAVERN_ADMIN_PASS=replace-with-a-long-secret
# Set to 1 only when you intentionally want to rotate the admin password on boot
# (also invalidates that admin's sessions).
# TAVERN_ADMIN_PASS_FORCE=0
# Set both to 1 when HTTPS terminates at nginx/Caddy — never expose the app
# directly on a public interface while TRUST_PROXY=1.
# TAVERN_COOKIE_SECURE=1
# TAVERN_TRUST_PROXY=1

# Public signup (default on). Set 0 to admin-provision only.
# TAVERN_SIGNUP=0
# Canonical URL used in verification / reset emails (no trailing slash)
# TAVERN_PUBLIC_URL=https://tavern.example.com
# Optional; stamped onto the bootstrap admin and marked verified
# TAVERN_ADMIN_EMAIL=you@example.com

# SMTP — leave TAVERN_SMTP_HOST unset to log links instead of sending
# (do not run public signup with log-only mail).
# TAVERN_SMTP_HOST=mail.example.com
# TAVERN_SMTP_PORT=587
# TAVERN_SMTP_USER=
# TAVERN_SMTP_PASS=
# TAVERN_SMTP_FROM=tavern@example.com
# starttls (587) | tls (465) | off (local/unencrypted)
# TAVERN_SMTP_SECURITY=starttls

# Per-user disk quota for owned project assets, exports, and import staging
# (default 10 GiB). Collaborator uploads count against the project owner.
# TAVERN_USER_QUOTA_GB=10
# Or set an exact byte cap:
# TAVERN_USER_QUOTA_BYTES=10737418240
